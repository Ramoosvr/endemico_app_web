<%= form_with model: ingredient, url: url, method: (ingredient.persisted? ? :patch : :post), local: true, class: "insumo-form" do |f| %>
  <% if ingredient.errors.any? %>
    <div class="pos-flash pos-flash--error">
      <%= ingredient.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <label class="insumo-field">
    <span>Nombre</span>
    <%= f.text_field :name, required: true, placeholder: "ej. leche entera" %>
  </label>

  <label class="insumo-field">
    <span>Sección (como en Matriz)</span>
    <%= f.text_field :section, list: "insumo-sections", placeholder: "ej. LECHES Y LÁCTEOS" %>
    <datalist id="insumo-sections">
      <% Ingredient.active.where.not(section: nil).distinct.pluck(:section).each do |sec| %>
        <option value="<%= sec %>"></option>
      <% end %>
    </datalist>
  </label>

  <label class="insumo-field">
    <span>Marca</span>
    <%= f.text_field :brand %>
  </label>

  <div class="insumo-field-row">
    <label class="insumo-field">
      <span>Presentación (cantidad)</span>
      <%= f.number_field :package_size, step: "0.001", min: 0, placeholder: "ej. 1000" %>
    </label>
    <label class="insumo-field">
      <span>Precio del paquete</span>
      <%= f.number_field :package_price, step: "0.01", min: 0 %>
    </label>
  </div>

  <div class="insumo-field-row">
    <label class="insumo-field">
      <span>Unidad</span>
      <%= f.select :unit, Ingredient::UNITS.map { |u| [u, u] } %>
    </label>
    <label class="insumo-field">
      <span>Precio por unidad</span>
      <%= f.number_field :cost_per_unit, step: "0.01", min: 0, placeholder: "0.00" %>
    </label>
  </div>

  <div class="insumo-field-row">
    <label class="insumo-field">
      <span><%= ingredient.persisted? ? "Conteo físico (corrige el stock)" : "Stock inicial" %></span>
      <%= f.number_field :stock, step: "0.001" %>
    </label>
    <label class="insumo-field">
      <span>Stock mínimo</span>
      <%= f.number_field :min_stock, step: "0.001", min: 0 %>
    </label>
  </div>

  <label class="insumo-field">
    <span>Dónde comprar</span>
    <%= f.text_field :supplier, placeholder: "ej. Costco" %>
  </label>

  <div class="insumo-form-actions">
    <%= f.submit submit_label, class: "insumo-submit" %>
    <% if ingredient.persisted? %>
      <%= link_to "cancelar", insumos_path, class: "insumo-btn" %>
    <% end %>
  </div>
<% end %>
