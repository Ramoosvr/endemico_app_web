<% content_for :title, "Editar #{@ingredient.name} · Endémico" %>

<div class="pos">
  <%= render "shared/header", heading: "Editar insumo", active: :insumos, zone: :backoffice %>

  <div class="insumos-layout insumos-layout--edit">
    <aside class="insumos-form">
      <div class="corte-section-head">
        <h2><%= @ingredient.name %></h2>
      </div>
      <%= render "form", ingredient: @ingredient, submit_label: "Guardar cambios", url: ingredient_path(@ingredient) %>
    </aside>
  </div>
</div>
