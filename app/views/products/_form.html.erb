<%= form_with model: product,
              url: product.persisted? ? product_path(product) : products_path,
              method: product.persisted? ? :patch : :post,
              local: true,
              class: "pform" do |f| %>

  <div class="pform-field">
    <%= f.label :name, "Nombre", class: "pform-label" %>
    <%= f.text_field :name, required: true, placeholder: "ej. Sandwich de pavo", class: "pform-input" %>
  </div>

  <div class="pform-field">
    <%= f.label :kind, "Tipo", class: "pform-label" %>
    <%= f.select :kind, Product::KINDS.map { |k| [k.capitalize, k] }, { prompt: "—" }, class: "pform-input", required: true %>
  </div>

  <div class="pform-grid">
    <div class="pform-field">
      <%= f.label :cost, "Costo", class: "pform-label" %>
      <div class="pform-money">
        <span>$</span>
        <%= f.number_field :cost, step: 0.01, min: 0, required: true, placeholder: "0", class: "pform-input" %>
      </div>
    </div>

    <div class="pform-field">
      <%= f.label :price, "Venta", class: "pform-label" %>
      <div class="pform-money">
        <span>$</span>
        <%= f.number_field :price, step: 0.01, min: 0, required: true, placeholder: "0", class: "pform-input" %>
      </div>
    </div>

    <div class="pform-field">
      <%= f.label :stock, "Stock", class: "pform-label" %>
      <%= f.number_field :stock, step: 1, min: 0, required: true, placeholder: "0", class: "pform-input" %>
    </div>
  </div>

  <div class="pform-field">
    <%= f.label :ingredients_list, "Ingredientes", class: "pform-label" %>
    <%= f.text_area :ingredients_list,
          rows: 5,
          placeholder: "uno por línea&#10;pan&#10;jamón&#10;queso",
          class: "pform-input pform-textarea" %>
    <p class="pform-hint">Uno por línea (o separados por coma). Estos vienen por defecto. Extras y opciones los configurás abajo.</p>
  </div>

  <%= f.submit (product.persisted? ? "Guardar cambios" : "Agregar producto"), class: "pform-submit" %>
<% end %>
