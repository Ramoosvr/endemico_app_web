<%# A single- or multiple-choice option group rendered as chips. %>
<% preselected = og.preselected_choice %>
<%# Required single choices (Leche, Endulzante…) stay on one line. %>
<ul class="cmz-list <%= og.single? ? 'cmz-list--chips' : '' %><%= ' cmz-list--row' if og.single? && og.required %>">
  <% og.option_choices.each do |oc| %>
    <li class="cmz-item<%= " cmz-item--soldout" unless oc.available %>">
      <label class="cmz-check">
        <% if og.single? %>
          <input type="radio"
                 name="single_choice_<%= og.id %>"
                 data-group-id="<%= og.id %>"
                 data-choice-id="<%= oc.id %>"
                 data-extra-price="<%= oc.extra_price.to_f %>"
                 data-action="change->customize#selectSingle<%= " click->customize#toggleOptional" unless og.required %>"
                 <% if oc == preselected %>checked data-was-checked="true"<% end %>
                 <%= "disabled" unless oc.available %>>
        <% else %>
          <input type="checkbox"
                 name="option_choice_ids[]"
                 value="<%= oc.id %>"
                 data-extra-price="<%= oc.extra_price.to_f %>"
                 data-action="change->customize#recalc"
                 <%= "checked" if oc.default_selected && oc.available %>
                 <%= "disabled" unless oc.available %>>
        <% end %>
        <span class="cmz-item-name"><%= oc.name %></span>
        <% unless oc.available %><span class="cmz-soldout-tag">agotado</span><% end %>
        <% if oc.available && oc.extra_price.to_f > 0 %>
          <span class="cmz-item-price">+$<%= oc.extra_price.to_d.frac.zero? ? oc.extra_price.to_i : format("%.2f", oc.extra_price) %></span>
        <% end %>
      </label>
    </li>
  <% end %>
</ul>
<% if og.single? %>
  <%= hidden_field_tag "option_choice_ids[]", preselected&.id, data: { group_hidden: og.id } %>
<% end %>
