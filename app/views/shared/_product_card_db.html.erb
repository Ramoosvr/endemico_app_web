<%
  stock_available = product.stock.to_i > 0
  customizable    = product.customizable?
  has_photo       = product.photo.attached?
  action          = if !stock_available then :soldout
                    elsif customizable then :open_modal
                    else :add_one end
  card_classes    = ["pcard"]
  card_classes << "pcard--btn"   if action != :soldout
  card_classes << "pcard--noimg" unless has_photo
  card_classes << "pcard--soldout" if action == :soldout
  size_group      = product.option_groups.find(&:size?)
  sizes           = size_group ? size_group.option_choices.select(&:available) : []
  card_classes << "pcard--sized" if sizes.size > 1
%>

<% card_body = capture do %>
  <% if has_photo %>
    <span class="pcard-photo">
      <%= image_tag product.photo, class: "pcard-photo-img", alt: product.name %>
      <% unless stock_available %>
        <span class="pcard-sold-out">Agotado</span>
      <% end %>
    </span>
    <span class="pcard-body">
      <span class="pcard-name"><%= product.name %></span>
      <% if sizes.size > 1 %>
        <span class="pcard-price pcard-sizes"><%= sizes.map { |oc| "$#{format("%.2f", product.price.to_d + oc.extra_price.to_d)}" }.join(" / ") %></span>
      <% else %>
        <span class="pcard-price">$<%= format("%.2f", product.price) %></span>
      <% end %>
    </span>
  <% else %>
    <span class="pcard-textonly">
      <span class="pcard-name"><%= product.name %></span>
      <% if sizes.size > 1 %>
        <span class="pcard-price pcard-sizes"><%= sizes.map { |oc| "$#{format("%.2f", product.price.to_d + oc.extra_price.to_d)}" }.join(" / ") %></span>
      <% else %>
        <span class="pcard-price">$<%= format("%.2f", product.price) %></span>
      <% end %>
    </span>
    <% unless stock_available %>
      <span class="pcard-sold-out pcard-sold-out--textonly">Agotado</span>
    <% end %>
  <% end %>
<% end %>

<% case action %>
<% when :open_modal %>
  <button type="button"
          class="<%= card_classes.join(" ") %>"
          data-product-id="<%= product.id %>"
          aria-label="Agregar <%= product.name %>"
          onclick="document.getElementById('customize-<%= product.id %>').showModal()">
    <%= card_body %>
  </button>
<% when :add_one %>
  <%= button_to items_cart_path,
                method: :post,
                params: { product_id: product.id, quantity: 1 },
                class: card_classes.join(" "),
                form: { class: "pcard-form", data: { product_id: product.id } },
                aria: { label: "Agregar #{product.name}" } do %>
    <%= card_body %>
  <% end %>
<% else %>
  <article class="<%= card_classes.join(" ") %>" data-product-id="<%= product.id %>">
    <%= card_body %>
  </article>
<% end %>

<% if customizable && stock_available %>
  <%= render "shared/product_customize_modal", product: product %>
<% end %>
