<article class="pcard" data-product-id="<%= product.id %>">
  <div class="pcard-photo">
    <% if product.stock > 0 %>
      <% if product.customizable? %>
        <button type="button"
                class="pcard-add"
                aria-label="Agregar <%= product.name %>"
                onclick="document.getElementById('customize-<%= product.id %>').showModal()">+</button>
      <% else %>
        <%= button_to items_cart_path, method: :post, params: { product_id: product.id, quantity: 1 }, class: "pcard-add", form: { class: "pcard-add-form" }, aria: { label: "Agregar #{product.name}" } do %>+<% end %>
      <% end %>
    <% end %>

    <% if product.photo.attached? %>
      <%= image_tag product.photo, class: "pcard-photo-img", alt: product.name %>
    <% else %>
      <div class="pcard-photo-placeholder">
        <span><%= product.name.first.upcase %></span>
      </div>
    <% end %>
    <% if product.stock <= 0 %>
      <div class="pcard-sold-out">Agotado</div>
    <% end %>
  </div>
  <div class="pcard-body">
    <p class="pcard-caption">Stock: <%= product.stock %></p>
    <h3 class="pcard-name"><%= product.name %></h3>
    <p class="pcard-price">$<%= format("%.2f", product.price) %></p>
  </div>
</article>

<% if product.customizable? && product.stock > 0 %>
  <%= render "shared/product_customize_modal", product: product %>
<% end %>
