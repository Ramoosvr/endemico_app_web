<dialog id="customize-<%= product.id %>" class="cmz" data-controller="customize" data-customize-base-price-value="<%= product.price.to_f %>">
  <%= form_with url: items_cart_path, method: :post, local: true, class: "cmz-form", data: { customize_target: "form", action: "submit->customize#validate" } do %>
    <%= hidden_field_tag :product_id, product.id %>
    <%= hidden_field_tag :quantity, 1 %>

    <header class="cmz-head">
      <h2 class="cmz-title"><%= product.name %></h2>
      <button type="button" class="cmz-close" data-action="click->customize#close" aria-label="Cerrar">×</button>
    </header>

    <div class="cmz-body">
      <% packaging = Ingredient::PACKAGING_CATEGORIES %>
      <% defaults = product.product_ingredients.select { |pi| pi.default_included && !packaging.include?(pi.ingredient.category) } %>
      <% extras   = product.product_ingredients.reject { |pi| pi.default_included } %>
      <% groups   = product.option_groups.to_a %>
      <% main_groups  = groups.reject(&:extra?) %>
      <% extra_groups = groups.select(&:extra?) %>

      <%# Required choices first: Tamaño (big buttons), Sabor, Leche, Endulzante %>
      <% main_groups.each do |og| %>
        <section class="cmz-section">
          <h3 class="cmz-section-title">
            <%= og.name %>
            <% if og.required %><span class="cmz-req">obligatorio</span><% end %>
          </h3>
          <% if og.size? %>
            <% preselected = og.preselected_choice %>
            <ul class="cmz-list cmz-list--sizes">
              <% og.option_choices.each do |oc| %>
                <li class="cmz-item<%= " cmz-item--soldout" unless oc.available %>">
                  <label class="cmz-check">
                    <input type="radio"
                           name="single_choice_<%= og.id %>"
                           data-group-id="<%= og.id %>"
                           data-choice-id="<%= oc.id %>"
                           data-extra-price="<%= oc.extra_price.to_f %>"
                           data-action="change->customize#selectSingle"
                           <%= "checked" if oc == preselected %>
                           <%= "disabled" unless oc.available %>>
                    <span class="cmz-size-name"><%= oc.name %></span>
                    <% if oc.available %>
                      <span class="cmz-size-price">$<%= format("%.2f", product.price.to_d + oc.extra_price.to_d) %></span>
                    <% else %>
                      <span class="cmz-soldout-tag">agotado</span>
                    <% end %>
                  </label>
                </li>
              <% end %>
            </ul>
            <%= hidden_field_tag "option_choice_ids[]", preselected&.id, data: { group_hidden: og.id } %>
          <% else %>
            <%= render "shared/customize_choice_list", og: og %>
          <% end %>
        </section>
      <% end %>

      <% if extra_groups.any? || extras.any? %>
        <section class="cmz-section">
          <h3 class="cmz-section-title">Extras</h3>
          <div class="cmz-extras">
            <% extra_groups.each do |og| %>
              <% if og.counter? %>
                <% choices = og.option_choices.to_a %>
                <% sold_out = choices.none?(&:available) %>
                <div class="cmz-counter<%= " cmz-item--soldout" if sold_out %>" data-counter-group="<%= og.id %>" data-extra-price="<%= choices.first&.extra_price.to_f %>">
                  <div class="cmz-counter-row">
                    <span class="cmz-counter-name"><%= og.name %></span>
                    <% if sold_out %>
                      <span class="cmz-soldout-tag">agotado</span>
                    <% else %>
                    <span class="cmz-counter-price">+$<%= format("%.2f", choices.first&.extra_price.to_f) %> c/u</span>
                    <% end %>
                    <div class="cmz-stepper"<%= " hidden" if sold_out %>>
                      <button type="button" class="cmz-step" data-action="customize#decrement" aria-label="Quitar uno">−</button>
                      <input type="text" readonly inputmode="none" name="counter_qty[<%= og.id %>]" value="0" class="cmz-step-value" data-counter-qty aria-label="Cantidad de <%= og.name %>">
                      <button type="button" class="cmz-step" data-action="customize#increment" aria-label="Agregar uno">+</button>
                    </div>
                  </div>
                  <% if choices.size > 1 %>
                    <div class="cmz-counter-flavors" hidden>
                      <p class="cmz-counter-hint">¿Qué sabor?</p>
                      <ul class="cmz-list cmz-list--chips">
                        <% choices.each do |oc| %>
                          <li class="cmz-item<%= " cmz-item--soldout" unless oc.available %>">
                            <label class="cmz-check">
                              <input type="radio" name="counter_choice[<%= og.id %>]" value="<%= oc.id %>" data-action="change->customize#pickFlavor"<%= " disabled" unless oc.available %>>
                              <span class="cmz-item-name"><%= oc.name %></span>
                              <% unless oc.available %><span class="cmz-soldout-tag">agotado</span><% end %>
                            </label>
                          </li>
                        <% end %>
                      </ul>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="cmz-extra-group">
                  <p class="cmz-counter-name"><%= og.name %></p>
                  <%= render "shared/customize_choice_list", og: og %>
                </div>
              <% end %>
            <% end %>

            <% if extras.any? %>
              <ul class="cmz-list cmz-list--chips">
                <% extras.each do |pi| %>
                  <li class="cmz-item">
                    <label class="cmz-check">
                      <input type="checkbox"
                             name="extra_product_ingredient_ids[]"
                             value="<%= pi.id %>"
                             data-action="change->customize#recalc"
                             data-extra-price="<%= pi.extra_price.to_f %>">
                      <span class="cmz-item-name"><%= pi.ingredient.name %></span>
                      <% if pi.extra_price.to_f > 0 %>
                        <span class="cmz-item-price">+$<%= format("%.2f", pi.extra_price) %></span>
                      <% end %>
                    </label>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </div>
          <p class="cmz-error" data-customize-target="error" hidden></p>
        </section>
      <% end %>

      <% if defaults.any? %>
        <section class="cmz-section">
          <h3 class="cmz-section-title">Incluye <span class="cmz-hint-inline">· desmarca para quitar</span></h3>
          <ul class="cmz-list cmz-list--chips">
            <% defaults.each do |pi| %>
              <li class="cmz-item">
                <label class="cmz-check">
                  <input type="checkbox" checked
                         data-action="change->customize#toggleRemove"
                         data-remove-id="<%= pi.ingredient_id %>">
                  <span class="cmz-item-name"><%= pi.ingredient.name %></span>
                </label>
                <input type="hidden" name="remove_ingredient_ids[]" value="" data-remove-hidden="<%= pi.ingredient_id %>">
                <% if pi.extra_price.to_f > 0 %>
                  <label class="cmz-check cmz-check-sub">
                    <input type="checkbox"
                           name="extra_product_ingredient_ids[]"
                           value="<%= pi.id %>"
                           data-action="change->customize#recalc"
                           data-extra-price="<%= pi.extra_price.to_f %>">
                    <span class="cmz-item-name">+ extra</span>
                    <span class="cmz-item-price">+$<%= format("%.2f", pi.extra_price) %></span>
                  </label>
                <% end %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <section class="cmz-section cmz-notes-section">
        <details class="cmz-notes-details">
          <summary class="cmz-notes-summary">+ Agregar comentario</summary>
          <%= text_area_tag :notes, nil,
                rows: 2,
                placeholder: "ej. sin azúcar, para llevar…",
                class: "cmz-notes" %>
        </details>
      </section>
    </div>

    <footer class="cmz-foot">
      <div class="cmz-qty">
        <label>Cantidad</label>
        <input type="number" name="quantity" value="1" min="1" step="1" class="prod-form-input" data-action="input->customize#recalc" data-customize-target="qty">
      </div>
      <div class="cmz-total">
        <span>Total</span>
        <strong data-customize-target="total">$<%= format("%.2f", product.price) %></strong>
      </div>
      <button type="submit" class="auth-button cmz-submit">Agregar al pedido</button>
    </footer>
  <% end %>
</dialog>
