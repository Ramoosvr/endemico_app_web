<dialog id="customize-<%= product.id %>" class="cmz" data-controller="customize" data-customize-base-price-value="<%= product.price.to_f %>">
  <%= form_with url: items_cart_path, method: :post, local: true, class: "cmz-form", data: { customize_target: "form" } do %>
    <%= hidden_field_tag :product_id, product.id %>
    <%= hidden_field_tag :quantity, 1 %>

    <header class="cmz-head">
      <h2 class="cmz-title"><%= product.name %></h2>
      <button type="button" class="cmz-close" data-action="click->customize#close" aria-label="Cerrar">×</button>
    </header>

    <div class="cmz-body">
      <% defaults = product.product_ingredients.select { |pi| pi.default_included } %>
      <% extras   = product.product_ingredients.reject { |pi| pi.default_included } %>

      <%# Required single-choice option groups first (Temperatura, Leche, Shots, Endulzante) %>
      <% product.option_groups.each do |og| %>
        <section class="cmz-section">
          <h3 class="cmz-section-title">
            <%= og.name %>
            <% if og.required %><span class="cmz-req">obligatorio</span><% end %>
          </h3>
          <ul class="cmz-list <%= og.single? ? 'cmz-list--chips' : '' %>">
            <% og.option_choices.each do |oc| %>
              <li class="cmz-item">
                <label class="cmz-check">
                  <% if og.single? %>
                    <input type="radio"
                           name="single_choice_<%= og.id %>"
                           data-group-id="<%= og.id %>"
                           data-choice-id="<%= oc.id %>"
                           data-extra-price="<%= oc.extra_price.to_f %>"
                           data-action="change->customize#selectSingle"
                           <%= "checked" if oc.default_selected %>>
                  <% else %>
                    <input type="checkbox"
                           name="option_choice_ids[]"
                           value="<%= oc.id %>"
                           data-extra-price="<%= oc.extra_price.to_f %>"
                           data-action="change->customize#recalc"
                           <%= "checked" if oc.default_selected %>>
                  <% end %>
                  <span class="cmz-item-name"><%= oc.name %></span>
                  <% if oc.extra_price.to_f > 0 %>
                    <span class="cmz-item-price">+$<%= format("%.2f", oc.extra_price) %></span>
                  <% end %>
                </label>
              </li>
            <% end %>
          </ul>
          <% if og.single? %>
            <%= hidden_field_tag "option_choice_ids[]", (og.option_choices.find { |c| c.default_selected }&.id), data: { group_hidden: og.id } %>
          <% end %>
        </section>
      <% end %>

      <% if extras.any? %>
        <section class="cmz-section">
          <h3 class="cmz-section-title">Extras</h3>
          <ul class="cmz-list cmz-list--chips">
            <% extras.each do |pi| %>
              <li class="cmz-item">
                <label class="cmz-check">
                  <input type="checkbox"
                         name="extra_product_ingredient_ids[]"
                         value="<%= pi.id %>"
                         data-action="change->customize#recalc"
                         data-extra-price="<%= pi.extra_price.to_f %>">
                  <span class="cmz-item-name"><%= pi.ingredient.name %></span>
                  <% if pi.extra_price.to_f > 0 %>
                    <span class="cmz-item-price">+$<%= format("%.2f", pi.extra_price) %></span>
                  <% end %>
                </label>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <% if defaults.any? %>
        <section class="cmz-section">
          <h3 class="cmz-section-title">Incluye <span class="cmz-hint-inline">· desmarca para quitar</span></h3>
          <ul class="cmz-list cmz-list--chips">
            <% defaults.each do |pi| %>
              <li class="cmz-item">
                <label class="cmz-check">
                  <input type="checkbox" checked
                         data-action="change->customize#toggleRemove"
                         data-remove-id="<%= pi.ingredient_id %>">
                  <span class="cmz-item-name"><%= pi.ingredient.name %></span>
                </label>
                <input type="hidden" name="remove_ingredient_ids[]" value="" data-remove-hidden="<%= pi.ingredient_id %>">
                <% if pi.extra_price.to_f > 0 %>
                  <label class="cmz-check cmz-check-sub">
                    <input type="checkbox"
                           name="extra_product_ingredient_ids[]"
                           value="<%= pi.id %>"
                           data-action="change->customize#recalc"
                           data-extra-price="<%= pi.extra_price.to_f %>">
                    <span class="cmz-item-name">+ extra</span>
                    <span class="cmz-item-price">+$<%= format("%.2f", pi.extra_price) %></span>
                  </label>
                <% end %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <section class="cmz-section cmz-notes-section">
        <details class="cmz-notes-details">
          <summary class="cmz-notes-summary">+ Agregar comentario</summary>
          <%= text_area_tag :notes, nil,
                rows: 2,
                placeholder: "ej. sin azúcar, para llevar…",
                class: "cmz-notes" %>
        </details>
      </section>
    </div>

    <footer class="cmz-foot">
      <div class="cmz-qty">
        <label>Cantidad</label>
        <input type="number" name="quantity" value="1" min="1" step="1" class="prod-form-input" data-action="input->customize#recalc" data-customize-target="qty">
      </div>
      <div class="cmz-total">
        <span>Total</span>
        <strong data-customize-target="total">$<%= format("%.2f", product.price) %></strong>
      </div>
      <button type="submit" class="auth-button cmz-submit">Agregar al pedido</button>
    </footer>
  <% end %>
</dialog>
