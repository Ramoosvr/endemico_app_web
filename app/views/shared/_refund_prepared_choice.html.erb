<%# Asked on every refund: was the order already made? %>
<fieldset class="cname-label" style="border:0; padding:0; margin:0; display:grid; gap:8px;">
  <legend style="margin-bottom:6px;">¿Ya se preparó?</legend>
  <label style="display:flex; gap:10px; align-items:center; font-size:16px;">
    <input type="radio" name="prepared" value="1" required>
    Sí, ya se preparó: los insumos van a merma
  </label>
  <label style="display:flex; gap:10px; align-items:center; font-size:16px;">
    <input type="radio" name="prepared" value="0" required>
    No se preparó: los insumos regresan al stock
  </label>
</fieldset>
