<%= form_with model: user, url: url, method: (user.persisted? ? :patch : :post), local: true, class: "insumo-form" do |f| %>
  <% if user.errors.any? %>
    <div class="pos-flash pos-flash--error">
      <%= user.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <label class="insumo-field">
    <span>Nombre</span>
    <%= f.text_field :name, required: true, placeholder: "ej. ana", autocomplete: "off" %>
  </label>

  <label class="insumo-field">
    <span>Rol</span>
    <%= f.select :role, User::ROLES.map { |r| [ r, r ] } %>
  </label>

  <label class="insumo-field">
    <span><%= user.persisted? ? "Nueva contraseña (opcional)" : "Contraseña" %></span>
    <%= f.password_field :password, autocomplete: "new-password", required: !user.persisted?, placeholder: "••••••••" %>
  </label>

  <label class="insumo-field">
    <span>Confirmar contraseña</span>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", required: !user.persisted?, placeholder: "••••••••" %>
  </label>

  <div class="insumo-form-actions">
    <%= f.submit submit_label, class: "insumo-submit" %>
    <% if user.persisted? %>
      <%= link_to "cancelar", usuarios_path, class: "insumo-btn" %>
    <% end %>
  </div>
<% end %>
